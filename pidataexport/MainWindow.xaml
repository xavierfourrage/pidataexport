<Window x:Class="pidataexport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pidataexport"
        mc:Ignorable="d"
        Title="PIDataExport" Height="935" Width="800">
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Arrow"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Button body -->
                            <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            BorderBrush="DarkGray"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="contentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <!-- Spinner (hidden initially) -->
                            <Ellipse x:Name="spinner"
                             Width="16"
                             Height="16"
                             Stroke="Black"
                             StrokeThickness="2"
                             Visibility="Collapsed"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="spinnerRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightBlue"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>
    <Grid>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Label Content="AF Server: " VerticalAlignment="Top"/>
                <Label x:Name="AFServer" Margin="-8,0,0,0" FontWeight="Bold" />
                <Label Content="PI DA Server: " VerticalAlignment="Top"/>
                <Label x:Name="PIDAServer" Margin="-8,0,0,0" FontWeight="Bold"/>
                <Label>
                    <TextBlock>

                        <Hyperlink Click="OpenConnectionHelper_Click"> change </Hyperlink>
                    </TextBlock>
                </Label>

            </StackPanel>
           
            <StackPanel Margin="10,0,10,0">
                <ComboBox x:Name="AFDatabaseComboBox" 
                          SelectedIndex="0" 
                          SelectionChanged="LoadEquipements"                          
                          Margin="0,0,0,5"/>

                <ComboBox x:Name="EquipementComboBox"
          SelectedIndex="0"
          Margin="0,0,0,5"
          SelectionChanged="EquipementComboBox_SelectionChanged"/>


            </StackPanel>
            <StackPanel Margin="10,10,10,0">
                <StackPanel Orientation="Horizontal" >
                    <Label Content="Element Name [Filter]:"/>
                    <TextBox x:Name="Elementname" Width="200" Margin="1,0,10,0" Tag="fef"  Text="{Binding ElementName=EquipementComboBox, Path=Text}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Margin="0,0,0,0">
                            Phase [EF name Filter]:
                        </Label>
                        <TextBox x:Name="Eventname" Width="200" Height="25" Margin="0,0,10,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                       
                        <Label Margin="0,0,0,0">
                            Batch ID [Filter]:
                        </Label>
                        <TextBox x:Name="BatchID" Width="200" Height="25" Margin="0,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <Label Content="Search Time Frame:" />
                    <Label Content="From:" FontStyle="Italic" Margin="5,0,0,0"/>
                    <DatePicker x:Name="StartDatePicker" Width="150"/>
                    <Label Content="To:" FontStyle="Italic" Margin="10,0,0,0"/>
                    <DatePicker x:Name="EndDatePicker" Width="150"/>
                </StackPanel>
            </StackPanel>
          
           
            <Button Content="Search" Width="75" Margin="0,10,0,0" Click="Search_Click" Style="{StaticResource ButtonStyle}"/>


            <StackPanel Margin="10">
                <!-- Filter box -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="EF search filter:"/>
                    <TextBox x:Name="BatchFilterBox" 
                             Width="200" 
                             Margin="0,0,0,0" 
                            TextAlignment="Left"
                            HorizontalAlignment="Left"
                             TextChanged="BatchFilterBox_TextChanged"/>
                    <Label x:Name="numberOfResults" FontStyle="Italic" HorizontalAlignment="Right"/>
                </StackPanel>
               

                <!-- DataGrid -->
                <DataGrid x:Name="EFDataGrid"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserSortColumns="True"
          IsReadOnly="False"
          SelectionMode="Extended"
          SelectionUnit="FullRow"
          Margin="0,10,0,0"
          Height="236"
          ItemsSource="{Binding}">
                    <DataGrid.Columns>
                        <!-- Select column with header checkbox -->
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.Header>
                                <CheckBox Content="" 
                          Click="SelectAllCheckBox_Click"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Read-only text columns -->
                        <DataGridTextColumn Binding="{Binding BatchId}" Header="Batch ID" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Binding="{Binding Name}" Header="EF Name" Width="*" IsReadOnly="True"/>

                        <!-- Start Time -->
                        <DataGridTextColumn Header="Start Time" Width="135" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="StartTime" StringFormat="{}{0:G}" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <!-- End Time -->
                        <DataGridTextColumn Header="End Time" Width="135" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="EndTime" StringFormat="{}{0:G}" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>



          

            <StackPanel Margin="10">
                <!-- Filter box -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding ElementName=EquipementComboBox,Path=Text}"/>
                    <Label Content="attributes (PI Tags only) search:" Margin="-5,0,0,0"/>
                    <TextBox x:Name="AttrFilterBox"
                             Width="200"
                             Margin="0,0,0,5"
                            HorizontalAlignment="Left"
                             TextChanged="AttrFilterBox_TextChanged"/>
                </StackPanel>
                

                <DataGrid x:Name="EFAttrDataGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="False"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              Margin="0,10,0,0"
              Height="252">
                    <DataGrid.Columns>
                        <!-- Checkbox with header -->
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="SelectAllCheckBox"
                              Content=""
                              Click="SelectAllCheckBox_attr_Click"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Attribute Name -->
                        <DataGridTextColumn Binding="{Binding Name}" Header="Attribute Name" Width="*"/>

                        <!-- Tag Name -->
                        <DataGridTextColumn Binding="{Binding TagName}" Header="PI Tag" Width="*"/>

                        <!-- Category -->
                        <DataGridTextColumn Binding="{Binding Category}" Header="Category" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>


          
          

            <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                
                <RadioButton x:Name="CompressedRadio" Content="Compressed" IsChecked="True" Margin="0,5,10,0"/>
                <RadioButton x:Name="SampledRadio" Content="Sampled" Margin="0,5,0,0"/>
                

                <TextBox x:Name="SampleIntervalBox"
         Width="55"
                         Height="20"
         Margin="5,2,0,0"
         PreviewTextInput="SampleIntervalBox_PreviewTextInput"
         LostFocus="SampleIntervalBox_LostFocus"
         ToolTip="Enter duration in format hh:mm:ss"
         Text="hh:mm:ss"                />
            </StackPanel>
           
            <!-- Export button -->
            <Button Content="Export" Width="75" Margin="0,10,0,0" Click="Export_Click" Style="{StaticResource ButtonStyle}"/>
        </StackPanel>




    </Grid>
   
</Window>
