<Window x:Class="pidataexport.ConnectionHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection Helper" Height="220" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- AF Servers -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 5">
            <Label Content="AF Server:" Width="120"/>
            <ComboBox Width="200" Name="AFServersComboBox" SelectionChanged="ComboBoxes_SelectionChanged"/>
        </StackPanel>

        <!-- PI Data Archives -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 5">
            <Label Content="PI Data Archive:" Width="120"/>
            <ComboBox Width="200" Name="PIDAServersComboBox" SelectionChanged="ComboBoxes_SelectionChanged"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Label Content="Specify credentials"/>
            <CheckBox x:Name="useCreds" Margin="10,6,0,0" ></CheckBox>
        </StackPanel>

        
        <StackPanel Orientation="Horizontal" Grid.Row="3">
            <!--  <Label Content="Remember choice "/> -->
            <!--  <CheckBox x:Name="rememberChoice" Margin="11,6,0,0" IsEnabled="False"></CheckBox> -->
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0 10" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="5" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
